{
  "openapi": "3.0.0",
  "info": {
    "title": "Hotel Reservation API",
    "version": "1.0.0"
  },
  "paths": {
    "/getHotelSpecialDeals": {
      "get": {
        "summary": "Gets current special deals and offers available for hotels",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/getAvailableRooms": {
      "get": {
        "summary": "Gets available hotel rooms for a specific Octank hotel location, date and guest count. The hotel location options are Chicago, San Francisco, or London.",
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["Chicago", "San Francisco", "London"]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "guests",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}