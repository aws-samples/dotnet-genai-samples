@page "/bedrock-agent"
@inherits PageBase
@using System.Text.RegularExpressions
@using Amazon.BedrockAgent
@using Amazon.BedrockAgent.Model
@using Amazon.BedrockAgentRuntime
@using Amazon.BedrockAgentRuntime.Model
@using Amazon.GenAI.Abstractions
@using Amazon.GenAI.Components
@using Amazon.GenAI.Models
@using Amazon.Runtime.Internal
@using Amazon.S3
@inject AmazonBedrockAgentClient AgentClient
@inject AmazonBedrockAgentRuntimeClient AgentRuntimeClient
@inject AmazonS3Client AmazonS3Client

<div class="container-fluid h-100 d-flex flex-column">
    <MessageHistory History="MessageHistory"></MessageHistory>
</div>

<div class="input-wrapper">
    <Prompt Model="MessageHistory"
    OnPromptChanged="PromptChanged"
    BuiltinPrompt="@BuiltinPrompt"
    Status="Status">
    </Prompt>
</div>

@code {

    private KnowledgeBaseSummary? _knowledgeBase;
    private List<KnowledgeBaseSummary?>? _knowledgeBases = [];
    private string sessionId = Guid.NewGuid().ToString();

    AutoConstructedList<RetrievalFilter>? _filters;

    private HashSet<string> _countries = [];
    private HashSet<string> _cities = [];
    Match? _match;

    protected override async Task OnInitializedAsync()
    {
        await SetAgentVariables();
        await base.OnInitializedAsync();
    }

    private async Task PromptChanged(string prompt)
    {
        BuiltinPrompt = prompt;

        if (string.IsNullOrEmpty(prompt)) return;

        Status = Status.Thinking;
        await MessageHistory.AddUserMessage(prompt);

        try
        {
            if (!string.IsNullOrEmpty(Constants.AgentId) && !string.IsNullOrEmpty(Constants.AgentAliasId))
            {
                var agentrequest = new InvokeAgentRequest
                    {
                        AgentId = Constants.AgentId,
                        AgentAliasId = Constants.AgentAliasId,
                        EnableTrace = true,
                        SessionId = sessionId,
                        InputText = prompt
                    };

                var result = await AgentRuntimeClient.InvokeAgentAsync(agentrequest);

                var response = string.Empty;

                foreach (var chunkEvent in result.Completion)
                {
                    var payloadchunk = new PayloadPart();
                    var returnControlPayload = new ReturnControlPayload();
                    var tracechunk = new TracePart();

                    if (chunkEvent is PayloadPart)
                    {
                        payloadchunk = (PayloadPart)chunkEvent;
                        if (payloadchunk.Bytes != null)
                        {
                            var chunkText = System.Text.Encoding.UTF8.GetString(payloadchunk.Bytes.ToArray());
                            response += chunkText;
                        }
                    }

                    #region Uncomment the following section if you want to handle return control payloads or trace parts
                    // else if (chunkEvent is ReturnControlPayload)
                    // {
                    //     returnControlPayload = (ReturnControlPayload)chunkEvent;
                    // }
                    // else if (chunkEvent is TracePart)
                    // {
                    //     tracechunk = (TracePart)chunkEvent;
                    //     var orchestrationTrace = tracechunk.Trace.OrchestrationTrace;

                    //     if (orchestrationTrace != null)
                    //     {
                    //         if (orchestrationTrace.Rationale != null)
                    //         {
                    //             await MessageHistory.AddAiMessage(orchestrationTrace.Rationale.Text);
                    //         }
                    //         else if (orchestrationTrace.ModelInvocationInput != null)
                    //         {
                    //             await MessageHistory.AddAiMessage(orchestrationTrace.ModelInvocationInput.Text);
                    //         }
                    //         else if (orchestrationTrace.Observation != null)
                    //         {
                    //             await MessageHistory.AddAiMessage(orchestrationTrace.Observation.FinalResponse?.Text ?? string.Empty);
                    //         }
                    //     }
                    // }
                    #endregion
                }

                await MessageHistory.AddAiMessage(response);
            }
        }
        catch (AmazonBedrockAgentRuntimeException ex)
        {
            Console.WriteLine($"AWS Error: {ex.Message}");
            throw;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"General Error: {ex.Message}");
            throw;
        }

        await UpdatePage();
    }

    private async Task SetAgentVariables()
    {
        if (string.IsNullOrEmpty(Constants.AgentId) || string.IsNullOrEmpty(Constants.AgentAliasId))
        {
            var agents = await AgentClient.ListAgentsAsync(new ListAgentsRequest
                {
                    MaxResults = 5
                });

            var OctankAgent = agents.AgentSummaries.FirstOrDefault(x => x.AgentName.ToLower().Equals("octankhotelagent"));

            var agentAliases = await AgentClient.ListAgentAliasesAsync(new ListAgentAliasesRequest
                {
                    AgentId = OctankAgent?.AgentId,
                });

            var aliasSummaries = agentAliases.AgentAliasSummaries.FirstOrDefault(x => x.AgentAliasName.ToLower().Equals("octank-staging"));

            Constants.AgentId = OctankAgent?.AgentId ?? string.Empty;
            Constants.AgentAliasId = aliasSummaries?.AgentAliasId ?? string.Empty;
        }
    }
}
