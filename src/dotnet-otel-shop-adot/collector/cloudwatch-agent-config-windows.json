{
  "agent": {
    "metrics_collection_interval": 60
  },
  "traces": {
    "traces_collected": {
      "application_signals": {}
    }
  },
  "metrics": {
    "namespace": "DotnetShop",
    "metrics_collected": {
      "otlp": {
        "grpc_endpoint": "127.0.0.1:4317",
        "http_endpoint": "127.0.0.1:4318"
      }
    }
  },
  "logs": {
    "metrics_collected": {
      "application_signals": {}
    },
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "C:\\shop-logs\\shop-api*.log",
            "log_group_name": "/dotnet-shop/api",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 7
          },
          {
            "file_path": "C:\\shop-logs\\shop-web*.log",
            "log_group_name": "/dotnet-shop/web",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 7
          },
          {
            "file_path": "C:\\shop-logs\\shopper-journey*.log",
            "log_group_name": "/dotnet-shop/journey",
            "log_stream_name": "{instance_id}",
            "retention_in_days": 7
          }
        ]
      }
    }
  }
}
