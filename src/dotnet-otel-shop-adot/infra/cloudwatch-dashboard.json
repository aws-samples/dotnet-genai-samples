{
  "start": "-PT3H",
  "widgets": [
    {
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 24,
      "height": 2,
      "properties": {
        "markdown": "## Cloud Outfitters (.NET + ADOT)\nBusiness metrics from custom `Meter` code; service health from **Application Signals**; runtime metrics from ADOT auto-instrumentation."
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 2,
      "width": 8,
      "height": 4,
      "properties": {
        "title": "Orders processed",
        "region": "us-east-1",
        "view": "singleValue",
        "stat": "Sum",
        "period": 300,
        "metrics": [
          [
            {
              "expression": "SELECT SUM(OrdersProcessed) FROM DotnetShop GROUP BY outcome",
              "id": "q1",
              "label": "",
              "region": "us-east-1"
            }
          ]
        ],
        "setPeriodToTimeRange": true
      }
    },
    {
      "type": "metric",
      "x": 8,
      "y": 2,
      "width": 8,
      "height": 4,
      "properties": {
