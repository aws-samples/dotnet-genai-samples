        "view": "singleValue",
        "stat": "Sum",
        "period": 300,
        "metrics": [
          [
            {
              "expression": "SELECT SUM(OrderRevenue) FROM DotnetShop",
              "id": "q1",
              "label": "Revenue",
              "region": "us-east-1"
            }
          ]
        ],
        "setPeriodToTimeRange": true
      }
    },
