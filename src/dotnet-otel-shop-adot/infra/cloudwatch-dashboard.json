        "view": "timeSeries",
        "stat": "Average",
        "period": 300,
        "metrics": [
          [
            {
              "expression": "SELECT AVG(Latency) FROM SCHEMA(ApplicationSignals, Environment, Operation, RemoteOperation, RemoteResourceIdentifier, RemoteResourceType, RemoteService, Service) WHERE Service = 'shop-api' AND RemoteService = 'AWS::DynamoDB' GROUP BY RemoteOperation, RemoteResourceIdentifier ORDER BY AVG() DESC",
