        "title": "DynamoDB calls by operation (Application Signals)",
        "region": "us-east-1",
        "view": "timeSeries",
        "stat": "SampleCount",
        "period": 300,
        "metrics": [
          [
            {
              "expression": "SELECT COUNT(Latency) FROM SCHEMA(ApplicationSignals, Environment, Operation, RemoteOperation, RemoteResourceIdentifier, RemoteResourceType, RemoteService, Service) WHERE Service = 'shop-api' AND RemoteService = 'AWS::DynamoDB' GROUP BY RemoteOperation, RemoteResourceIdentifier ORDER BY COUNT() DESC",
              "id": "q1",
              "label": "",
              "region": "us-east-1"
            }
          ]
        ],
        "stacked": false
      }
    },
