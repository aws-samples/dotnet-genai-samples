{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Enabled": true,
      "Path": "/tmp/shop-logs/shop-api.log",
      "MaxSizeMB": 10,
      "RetainedFiles": 5
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "Exporter": "otlp",
    "AwsResourceDetector": "none"
  },
  "Shop": {
    "Storage": "InMemory",
    "SeedProducts": true,
    "Aws": {
      "ProductsTable": "shop-products",
      "CartsTable": "shop-carts",
      "OrdersTable": "shop-orders",
      "OrdersBySessionIndex": "SessionId-index",
      "OrderQueueUrl": ""
    },
    "Chaos": {
      "PaymentFailureRate": 0.1,
      "PaymentMinLatencyMs": 50,
      "PaymentMaxLatencyMs": 600
    }
  },
  "AWS": {
    "Region": "us-east-1"
  }
}
