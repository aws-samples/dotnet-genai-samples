{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Enabled": true,
      "Path": "/tmp/shop-logs/shop-web.log",
      "MaxSizeMB": 10,
      "RetainedFiles": 5
    }
  },
  "AllowedHosts": "*",
  "Telemetry": {
    "Exporter": "otlp",
    "AwsResourceDetector": "none"
  },
  "ShopApi": {
    "BaseUrl": "http://localhost:5100"
  }
}
